{
 "version": 11,
 "randomSeed": "lade29",
 "graph": {
  "viewport": {
   "xmin": -6,
   "ymin": -4,
   "xmax": 6,
   "ymax": 4
  },
  "showGrid": false,
  "showXAxis": false,
  "showYAxis": false
 },
 "expressions": {
  "list": [
   {
    "type": "text",
    "id": "1",
    "text": "Linear first order DEs y' + p(x)y = q(x). Edit P (an antiderivative of p) and q in the first folder; drag the red point to set y(x_0) = k. The solution is y = (I(x) + C)/m(x), split into f_p = I/m and f_h = C/m."
   },
   {
    "type": "folder",
    "id": "2",
    "title": "Equation",
    "collapsed": false
   },
   {
    "type": "expression",
    "id": "3",
    "color": "#000000",
    "latex": "P\\left(x\\right)=-x^{2}",
    "folderId": "2",
    "hidden": true
   },
   {
    "type": "expression",
    "id": "4",
    "color": "#000000",
    "latex": "p\\left(x\\right)=\\frac{d}{dx}P\\left(x\\right)",
    "folderId": "2",
    "hidden": true
   },
   {
    "type": "expression",
    "id": "5",
    "color": "#000000",
    "latex": "q\\left(x\\right)=x",
    "folderId": "2",
    "hidden": true
   },
   {
    "type": "folder",
    "id": "6",
    "title": "Initial condition",
    "collapsed": true
   },
   {
    "type": "expression",
    "id": "7",
    "color": "#000000",
    "latex": "x_{0}=0",
    "folderId": "6",
    "slider": {
     "hardMin": true,
     "hardMax": true,
     "min": "-5",
     "max": "5",
     "step": "0.25"
    }
   },
   {
    "type": "expression",
    "id": "8",
    "color": "#000000",
    "latex": "k=1",
    "folderId": "6",
    "slider": {
     "hardMin": true,
     "hardMax": true,
     "min": "-3.5",
     "max": "3.5",
     "step": "0.25"
    }
   },
   {
    "type": "expression",
    "id": "9",
    "color": "#000000",
    "latex": "B=\\left[-3,-2.5,...,3\\right]",
    "folderId": "6"
   },
   {
    "type": "folder",
    "id": "10",
    "title": "Integrating factor",
    "collapsed": true
   },
   {
    "type": "expression",
    "id": "11",
    "color": "#000000",
    "latex": "m\\left(x\\right)=e^{P\\left(x\\right)}",
    "folderId": "10",
    "hidden": true
   },
   {
    "type": "expression",
    "id": "12",
    "color": "#000000",
    "latex": "I\\left(x\\right)=-\\frac{1}{2}e^{-x^{2}}",
    "folderId": "10",
    "hidden": true
   },
   {
    "type": "expression",
    "id": "25",
    "color": "#000000",
    "latex": "C=km\\left(x_{0}\\right)-I\\left(x_{0}\\right)",
    "folderId": "10"
   },
   {
    "type": "expression",
    "id": "13",
    "color": "#000000",
    "latex": "f_{p}\\left(x\\right)=\\frac{I\\left(x\\right)}{m\\left(x\\right)}",
    "folderId": "10",
    "hidden": true
   },
   {
    "type": "expression",
    "id": "14",
    "color": "#000000",
    "latex": "f_{h}\\left(x\\right)=\\frac{C}{m\\left(x\\right)}",
    "folderId": "10",
    "hidden": true
   },
   {
    "type": "text",
    "id": "15",
    "text": "I is any antiderivative of m(x)q(x): a closed form for the preset equations, a numerical integral from 0 otherwise. C is whatever makes y(x_0) = k.",
    "folderId": "10"
   },
   {
    "type": "folder",
    "id": "26",
    "title": "Axes",
    "collapsed": true
   },
   {
    "type": "expression",
    "id": "27",
    "color": "#000000",
    "latex": "y=0",
    "folderId": "26",
    "lineWidth": "2",
    "lineOpacity": "0.8"
   },
   {
    "type": "expression",
    "id": "28",
    "color": "#000000",
    "latex": "x=0",
    "folderId": "26",
    "lineWidth": "2",
    "lineOpacity": "0.8"
   },
   {
    "type": "folder",
    "id": "16",
    "title": "Family of solutions",
    "collapsed": true
   },
   {
    "type": "expression",
    "id": "17",
    "color": "#000000",
    "latex": "y=f_{p}\\left(x\\right)+\\frac{B}{m\\left(x\\right)}",
    "folderId": "16",
    "lineWidth": "2",
    "lineOpacity": "0.25"
   },
   {
    "type": "folder",
    "id": "18",
    "title": "Homogeneous and particular parts",
    "collapsed": true,
    "hidden": true
   },
   {
    "type": "expression",
    "id": "19",
    "color": "#388c46",
    "latex": "y=f_{h}\\left(x\\right)",
    "folderId": "18",
    "lineStyle": "DASHED",
    "lineWidth": "4"
   },
   {
    "type": "expression",
    "id": "20",
    "color": "#fa7e19",
    "latex": "y=f_{p}\\left(x\\right)",
    "folderId": "18",
    "lineStyle": "DASHED",
    "lineWidth": "4"
   },
   {
    "type": "folder",
    "id": "21",
    "title": "Solution",
    "collapsed": true
   },
   {
    "type": "expression",
    "id": "22",
    "color": "#2d70b3",
    "latex": "y=f_{h}\\left(x\\right)+f_{p}\\left(x\\right)",
    "folderId": "21",
    "lineWidth": "5"
   },
   {
    "type": "folder",
    "id": "23",
    "title": "Points",
    "collapsed": true,
    "inFrontOfEverything": true
   },
   {
    "type": "expression",
    "id": "24",
    "color": "#c74440",
    "latex": "\\left(x_{0},k\\right)",
    "folderId": "23",
    "label": "`(x_0, k)`",
    "labelOrientation": "above",
    "pointStyle": "OPEN",
    "pointSize": "15",
    "movablePointSize": "15",
    "dragMode": "XY",
    "showLabel": true,
    "labelSize": "1.5"
   }
  ]
 }
}
