   },
   {
    "type": "expression",
    "latex": "C=\\left(k_1+\\frac{1}{2}\\right)e^{-x_0^{2}}",
    "folderId": "15",
    "id": "16"
   },
   {
    "type": "expression",
    "latex": "m(x)=e^{P(x)-P\\left(x_0\\right)}",
    "folderId": "15",
    "id": "17"
   },
   {
    "type": "expression",
    "latex": "I(x)=\\int_{x_0}^{x}m\\left(t\\right)q\\left(t\\right)dt",
