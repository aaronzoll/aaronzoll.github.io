      {
        "type": "text",
        "id": "85",
        "folderId": "24",
        "text": "Because of the way Desmos parses actions, you need to hit R_{andomLine} and then R_{andomLineSet} to actually produce a random system of equations with a linear solution"
      },
      {
        "type": "expression",
        "id": "72",
        "folderId": "24",
        "color": "#c74440",
        "latex": "R_{andomLine}=a_{1}\\ \\to\\ M\\left(\\operatorname{random}\\left(\\right)-0.5\\right),\\ a_{2}\\ \\to\\ M\\left(\\operatorname{random}\\left(\\right)-0.5\\right),\\ a_{3}\\to\\ M\\left(\\operatorname{random}\\left(\\right)-0.5\\right),\\ b_{1}\\ \\to\\ \\ M\\left(\\operatorname{random}\\left(\\right)-0.5\\right),\\ b_{2}\\ \\to\\ M\\left(\\operatorname{random}\\left(\\right)-0.5\\right),\\ b_{3}\\to\\ M\\left(\\operatorname{random}\\left(\\right)-0.5\\right)"
      },
      {
        "type": "expression",
        "id": "76",
        "folderId": "24",
        "color": "#aaaaaa",
        "latex": "R_{andomLineSet}=c_{1}\\ \\to\\ \\ a_{1}+b_{1},\\ c_{2}\\ \\to a_{2}+b_{2},\\ c_{3}\\to\\ a_{3}+b_{3},\\ d_{1}\\ \\to\\ 2\\ a_{1}+2b_{1},d_{2}\\ \\to\\ 2a_{2}+2b_{2},\\ d_{3}\\to2\\ a_{3}+2b_{3}"
      },
      {
        "type": "folder",
        "id": "32",
        "title": "Some Linear Algebra"
      },
      {
        "type": "expression",
        "id": "33",
        "folderId": "32",
        "color": "#2d70b3",
        "latex": "D\\ =\\ a_{1}\\left(b_{2}c_{3}-b_{3}c_{2}\\right)-b_{1}\\left(a_{2}c_{3}-a_{3}c_{2}\\right)+c_{1}\\left(a_{2}b_{3}-a_{3}b_{2}\\right)"
      },
      {
        "type": "expression",
        "id": "34",
        "folderId": "32",
        "color": "#388c46",
        "latex": "D_{1}=d_{1}\\left(b_{2}c_{3}-b_{3}c_{2}\\right)-b_{1}\\left(d_{2}c_{3}-d_{3}c_{2}\\right)+c_{1}\\left(d_{2}b_{3}-d_{3}b_{2}\\right)"
      },
      {
        "type": "expression",
        "id": "35",
        "folderId": "32",
        "color": "#6042a6",
        "latex": "D_{2}=a_{1}\\left(d_{2}c_{3}-d_{3}c_{2}\\right)-d_{1}\\left(a_{2}c_{3}-a_{3}c_{2}\\right)+c_{1}\\left(a_{2}d_{3}-a_{3}d_{2}\\right)"
      },
      {
        "type": "expression",
        "id": "36",
        "folderId": "32",
        "color": "#aaaaaa",
        "latex": "D_{3}=a_{1}\\left(b_{2}d_{3}-b_{3}d_{2}\\right)-b_{1}\\left(a_{2}d_{3}-a_{3}d_{2}\\right)+d_{1}\\left(a_{2}b_{3}-a_{3}b_{2}\\right)"
      },
      {
        "type": "expression",
        "id": "37",
        "folderId": "32",
        "color": "#aaaaaa",
        "latex": "\\frac{1}{D}\\left(D_{1},D_{2},D_{3}\\right)",
        "pointSize": "5",
        "movablePointSize": "5"
      },
      {
        "type": "text",
        "id": "64",
        "folderId": "32",
        "text": "Define Cross and Dot Product"
      },
      {
        "type": "expression",
        "id": "43",
        "folderId": "32",
        "color": "#c74440",
        "latex": "X\\left(u,v\\right)\\ =\\ \\left[u\\left[2\\right]v\\left[3\\right]-u\\left[3\\right]v\\left[2\\right],\\ u\\left[3\\right]v\\left[1\\right]-u\\left[1\\right]v\\left[3\\right],\\ u\\left[1\\right]v\\left[2\\right]-u\\left[2\\right]v\\left[1\\right]\\right]"
      },
      {
        "type": "expression",
        "id": "44",
        "folderId": "32",
        "color": "#2d70b3",
        "latex": "T\\left(u,v\\right)\\ =\\ \\operatorname{total}\\left(uv\\right)"
      },
      {
        "type": "text",
        "id": "66",
        "folderId": "32",
        "text": "Chosen irrational vector"
      },
      {
        "type": "expression",
        "id": "45",
        "folderId": "32",
        "color": "#388c46",
        "latex": "q\\ =\\ \\left[1,\\sqrt{2},\\sqrt{3}\\right]"
      },
      {
        "type": "expression",
        "id": "46",
        "folderId": "32",
        "color": "#6042a6",
        "latex": "r_{1}\\ =\\ \\left[a_{1},\\ b_{1},\\ c_{1}\\right]"
      },
      {
        "type": "expression",
        "id": "47",
        "folderId": "32",
        "color": "#aaaaaa",
        "latex": "r_{2}=\\left[a_{2},\\ b_{2},\\ c_{2}\\right]"
      },
      {
        "type": "expression",
        "id": "49",
        "folderId": "32",
        "color": "#2d70b3",
        "latex": "r_{3}\\ =\\ \\left[a_{3},\\ b_{3},\\ c_{3}\\right]"
      },
      {
        "type": "expression",
        "id": "50",
        "folderId": "32",
        "color": "#388c46",
        "latex": "n_{12}\\ =\\ X\\left(r_{1},r_{2}\\right)"
      },
      {
        "type": "expression",
        "id": "51",
        "folderId": "32",
        "color": "#6042a6",
        "latex": "n_{13}\\ =\\ X\\left(r_{1},r_{3}\\right)"
      },
      {
        "type": "expression",
        "id": "52",
        "folderId": "32",
        "color": "#aaaaaa",
        "latex": "n_{23}\\ =\\ X\\left(r_{2},\\ r_{3}\\right)"
      },
      {
        "type": "expression",
        "id": "53",
        "folderId": "32",
        "color": "#c74440",
        "latex": "S=T(n_{12},n_{12})+T(n_{13},n_{13})+T(n_{23},n_{23})"
      },
      {
        "type": "text",
        "id": "68",
        "folderId": "32",
        "text": "Projection onto cross products space"
      },
      {
        "type": "expression",
        "id": "54",
        "folderId": "32",
        "color": "#2d70b3",
        "latex": "v=T\\left(n_{12},q\\right)n_{12}+T\\left(n_{13},q\\right)n_{13}+T\\left(n_{23},q\\right)n_{23}"
      },
      {
        "type": "expression",
        "id": "55",
        "folderId": "32",
        "color": "#388c46",
        "latex": "m\\ =\\ \\frac{v}{\\sqrt{T\\left(v,v\\right)}}"
      },
      {
        "type": "expression",
        "id": "57",
        "folderId": "32",
        "color": "#aaaaaa",
        "latex": "d\\ =\\ \\left[d_{1},\\ d_{2},\\ d_{3}\\right]"
      },
      {
        "type": "expression",
        "id": "56",
        "folderId": "32",
        "color": "#6042a6",
        "latex": "w\\ =\\ X(d[1]r_{2}-d[2]r_{1},\\ n_{12})+X(d[1]r_{3}-d[3]r_{1},\\ n_{13})+X(d[2]r_{3}-d[3]r_{2},\\ n_{23})"
      },
      {
        "type": "expression",
        "id": "58",
        "folderId": "32",
        "color": "#c74440",
        "latex": "p\\ =\\ \\frac{w}{S}"
      },
      {
        "type": "expression",
        "id": "69",
        "folderId": "32",
        "color": "#aaaaaa",
        "latex": "L_{ine}\\ =\\ \\left(p\\left[1\\right]+tm\\left[1\\right],\\ p\\left[2\\right]+tm\\left[2\\right],\\ p\\left[3\\right]+tm\\left[3\\right]\\right)",
        "parametricDomain": {
          "min": "-10\\left\\{\\operatorname{abs}\\left(E_{rr}\\right)<10^{-8}:1,\\ 0\\right\\}",
          "max": "10\\left\\{\\operatorname{abs}\\left(E_{rr}\\right)<10^{-8}:1,\\ 0\\right\\}"
        },
        "lineWidth": "3",
        "domain": {
          "min": "-10\\left\\{\\operatorname{abs}\\left(E_{rr}\\right)<10^{-8}:1,\\ 0\\right\\}",
          "max": "10\\left\\{\\operatorname{abs}\\left(E_{rr}\\right)<10^{-8}:1,\\ 0\\right\\}"
        }
      },
      {
        "type": "text",
        "id": "62",
        "folderId": "32",
        "text": "Test to see is solution is a line"
      },
      {
        "type": "expression",
        "id": "59",
        "folderId": "32",
        "color": "#2d70b3",
        "latex": "R_{es}\\ =\\ [T(r_{1},p)-d[1],T(r_{2},p)-d[2],T(r_{3},p)-d[3]]"
      },
      {
        "type": "expression",
        "id": "60",
        "folderId": "32",
        "color": "#388c46",
        "latex": "E_{rr}\\ =\\ T\\left(R_{es},R_{es}\\right)"
      },
      {
        "type": "expression",
        "id": "70",
        "folderId": "32",
        "color": "#6042a6",
        "latex": "L_{bound}\\ =\\ \\left\\{\\operatorname{abs}\\left(E_{rr}\\right)<10^{-8}:1,\\ 0\\right\\}"
      },
      {
        "type": "expression",
        "id": "30",
